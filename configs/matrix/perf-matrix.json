[
  {
    "test_name": "perf matrix",
    "port": 7000,
    "gates": {
      "require_all_clients": true,
      "max_generator_busy_pct": 90,
      "rtt_gate_ms": 0.15,
      "rtt_flag_fraction": 0.5,
      "max_error_reply_pct": 1
    },
    "verdict": {
      "min_valid_reps": 2,
      "tie_band_pct": 5,
      "require_no_overlap": true,
      "high_variance_cv_pct": 5
    },
    "matrix": {
      "profile": "smoke-loopback",
      "parameters": {
        "generator": {"type": "enum", "values": ["valkey-benchmark", "memtier"], "description": "Traffic generator that sends the load; it must offer every feature the cell needs"},
        "pipeline_depth": {"type": "int", "unit": "requests per connection", "min": 1, "description": "Requests each connection sends before waiting for replies"},
        "connections": {"type": "int", "unit": "connections", "min": 1, "description": "Total client connections across all generator hosts; independent of pipeline_depth; must split exactly over generator_hosts x client_threads"},
        "client_threads": {"type": "int", "unit": "threads per generator host", "min": 1, "description": "Generator threads on each generator host"},
        "generator_hosts": {"type": "int", "unit": "hosts", "min": 1, "description": "Client hosts sending load at once; the runner must be given that many"},
        "access_pattern": {"type": "enum", "values": ["uniform", "zipfian", "hotkey"], "description": "How keys are chosen"},
        "zipf_alpha": {"type": "real", "unit": "exponent", "min_exclusive": 0, "when": {"access_pattern": "zipfian"}, "description": "Skew of the Zipf key distribution"},
        "hot_fraction": {"type": "real", "unit": "fraction of operations", "min": 0, "max": 1, "when": {"access_pattern": "hotkey"}, "description": "Share of all operations sent to the hot keys"},
        "hot_keys": {"type": "int", "unit": "keys", "min": 1, "max": "{keys}", "when": {"access_pattern": "hotkey"}, "description": "Number of hot keys sharing hot_fraction"},
        "keys": {"type": "int", "unit": "keys", "min": 1, "description": "Keyspace size: keys the run addresses"},
        "preload_keys": {"type": "int", "unit": "keys", "min": 1, "max": "{keys}", "description": "Keys filled before the run; fewer than keys leaves part of the keyspace empty"},
        "key_size": {"type": "int", "unit": "bytes", "min": 1, "description": "Length of the longest key name; the prefix is padded to reach it"},
        "value_size": {"type": "int", "unit": "bytes", "min": 1, "description": "Size of a string value, or of each element of a data type"},
        "io_threads": {"type": "int", "unit": "threads, main included", "min": 1, "description": "Server io-threads setting"},
        "server_mode": {"type": "enum", "values": ["CME", "CMD"], "description": "Cluster mode enabled (a single node owning every slot) or disabled"},
        "tls": {"type": "bool", "description": "TLS between clients and server"},
        "server_config": {"type": "map", "description": "Server settings applied with CONFIG SET after the preload, such as maxmemory and maxmemory-policy"},
        "run_duration": {"type": "int", "unit": "seconds", "min": 1, "description": "Length of one rep"},
        "window": {"type": "range", "unit": "seconds, [start, end)", "description": "The measured part of a rep; must end within run_duration"},
        "reps": {"type": "int", "scope": "run", "min": 2, "description": "Reps per build per cell; a verdict needs 2 valid reps per build"},
        "build_pair": {"type": "str", "scope": "run", "source": "cli", "description": "Baseline and candidate builds, given to the runner as --build label=sha:dir; order alternates per rep"},
        "instance_shapes": {"type": "shapes", "scope": "run", "description": "Expected instance type per role (server, generator); the runner refuses hosts that report another"},
        "read_fraction": {"type": "real", "unit": "fraction of operations", "min": 0, "max": 1, "description": "Share of GETs in the string template's single stream"},
        "ttl_range": {"type": "range", "unit": "seconds", "description": "Expiry drawn per SET from [min, max], or null for none"},
        "fields_per_hash": {"type": "int", "unit": "fields", "min": 1, "description": "Fields in each preloaded hash, named f0 .. f<n-1>"},
        "field_selector": {"type": "enum", "values": ["index", "random_existing", "new", "missing"], "description": "Which field a hash command addresses"},
        "field_index": {"type": "int", "min": 0, "when": {"field_selector": "index"}, "description": "The field index for the index selector"},
        "list_length": {"type": "int", "unit": "elements", "min": 1, "description": "Elements in each preloaded list"},
        "range_start": {"type": "int", "unit": "index", "min": 0, "description": "First index of an LRANGE or ZRANGE"},
        "range_count": {"type": "int", "unit": "elements", "min": 1, "description": "Elements an LRANGE or ZRANGE returns at most"},
        "set_size": {"type": "int", "unit": "members", "min": 1, "description": "Members in each preloaded set, named m0 .. m<n-1>"},
        "member_selector": {"type": "enum", "values": ["index", "random_existing", "new", "missing"], "description": "Which member a set or sorted-set command addresses"},
        "member_index": {"type": "int", "min": 0, "when": {"member_selector": "index"}, "description": "The member index for the index selector"},
        "zset_size": {"type": "int", "unit": "members", "min": 1, "description": "Members in each preloaded sorted set, m<i> with score i"},
        "score": {"type": "real", "description": "Score a ZADD writes"},
        "withscores": {"type": "bool", "description": "Whether ZRANGE returns scores"},
        "stream_length": {"type": "int", "unit": "entries", "min": 1, "description": "Entries in each preloaded stream"},
        "fields_per_entry": {"type": "int", "unit": "fields", "min": 1, "description": "Fields in each stream entry"},
        "maxlen": {"type": "int", "unit": "entries", "min": 0, "description": "Approximate trim length for XADD (MAXLEN ~); 0 for no trim"},
        "xrange_count": {"type": "int", "unit": "entries", "min": 1, "description": "Entries an XRANGE returns at most"},
        "keys_per_call": {"type": "int", "unit": "keys", "min": 1, "description": "Keys per MSET or MGET"}
      },
      "scenarios": {
        "string": {"kind": "string", "description": "GET and SET over strings, reads a set share of one stream", "preload": {"type": "string"}, "uses": ["read_fraction", "ttl_range"]},
        "hset": {"description": "HSET one field of hashes", "preload": {"type": "hash", "elements": "{fields_per_hash}", "element_prefix": "f"},
                 "elements": {"name": "field", "prefix": "f", "count": "fields_per_hash", "selector": "field_selector", "index": "field_index", "allows": ["index", "random_existing", "new"]},
                 "commands": [{"command": "HSET {key} {field} {value}"}], "uses": ["fields_per_hash", "field_selector", "field_index"]},
        "hget": {"description": "HGET one field of hashes", "preload": {"type": "hash", "elements": "{fields_per_hash}", "element_prefix": "f"},
                 "elements": {"name": "field", "prefix": "f", "count": "fields_per_hash", "selector": "field_selector", "index": "field_index", "allows": ["index", "random_existing", "missing"]},
                 "commands": [{"command": "HGET {key} {field}", "read": true}], "uses": ["fields_per_hash", "field_selector", "field_index"]},
        "lpush": {"description": "LPUSH onto lists", "preload": {"type": "list", "elements": "{list_length}"},
                  "commands": [{"command": "LPUSH {key} {value}"}], "uses": ["list_length"]},
        "lrange": {"description": "LRANGE a slice of lists", "preload": {"type": "list", "elements": "{list_length}"},
                   "commands": [{"command": "LRANGE {key} {range_start} {range_stop}", "read": true}], "uses": ["list_length", "range_start", "range_count"]},
        "sadd": {"description": "SADD a member to sets", "preload": {"type": "set", "elements": "{set_size}", "element_prefix": "m"},
                 "elements": {"name": "member", "prefix": "m", "count": "set_size", "selector": "member_selector", "index": "member_index", "allows": ["index", "random_existing", "new"]},
                 "commands": [{"command": "SADD {key} {member}"}], "uses": ["set_size", "member_selector", "member_index"]},
        "sismember": {"description": "SISMEMBER a member of sets", "preload": {"type": "set", "elements": "{set_size}", "element_prefix": "m"},
                      "elements": {"name": "member", "prefix": "m", "count": "set_size", "selector": "member_selector", "index": "member_index", "allows": ["index", "random_existing", "missing"]},
                      "commands": [{"command": "SISMEMBER {key} {member}", "read": true}], "uses": ["set_size", "member_selector", "member_index"]},
        "zadd": {"description": "ZADD a member to sorted sets", "preload": {"type": "zset", "elements": "{zset_size}", "element_prefix": "m"},
                 "elements": {"name": "member", "prefix": "m", "count": "zset_size", "selector": "member_selector", "index": "member_index", "allows": ["index", "random_existing", "new"]},
                 "commands": [{"command": "ZADD {key} {score} {member}"}], "uses": ["zset_size", "member_selector", "member_index", "score"]},
        "zrange": {"description": "ZRANGE a slice of sorted sets", "preload": {"type": "zset", "elements": "{zset_size}", "element_prefix": "m"},
                   "commands": [{"command": "ZRANGE {key} {range_start} {range_stop}{withscores_arg}", "read": true}], "uses": ["zset_size", "range_start", "range_count", "withscores"]},
        "xadd": {"description": "XADD an entry to streams", "preload": {"type": "stream", "elements": "{stream_length}", "fields_per_entry": "{fields_per_entry}"},
                 "commands": [{"command": "XADD {key}{maxlen_arg} * {entry_fields}"}], "uses": ["stream_length", "fields_per_entry", "maxlen"]},
        "xrange": {"description": "XRANGE the first entries of streams", "preload": {"type": "stream", "elements": "{stream_length}", "fields_per_entry": "{fields_per_entry}"},
                   "commands": [{"command": "XRANGE {key} - + COUNT {xrange_count}", "read": true}], "uses": ["stream_length", "fields_per_entry", "xrange_count"]},
        "mset": {"description": "MSET of several random keys", "preload": {"type": "string"}, "multi_key": true,
                 "commands": [{"command": "MSET {keys_values}"}], "uses": ["keys_per_call"]},
        "mget": {"description": "MGET of several random keys", "preload": {"type": "string"}, "multi_key": true,
                 "commands": [{"command": "MGET {keys_list}", "read": true}], "uses": ["keys_per_call"]}
      }
    }
  }
]
