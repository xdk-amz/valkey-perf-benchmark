{
  "name": "smoke-loopback",
  "description": "Loopback smoke run on one host: every template on memtier, a few on valkey-benchmark, and Zipf, hot key, TTL, eviction and CME once each; small keyspace, short reps",
  "run": {"reps": 2},
  "values": {
    "generator": "memtier",
    "pipeline_depth": 1,
    "connections": 8,
    "client_threads": 2,
    "generator_hosts": 1,
    "access_pattern": "uniform",
    "keys": 10000,
    "preload_keys": 10000,
    "key_size": 16,
    "value_size": 64,
    "io_threads": 2,
    "server_mode": "CMD",
    "tls": false,
    "server_config": {},
    "run_duration": 4,
    "window": [1, 3]
  },
  "scenarios": {
    "string": {"read_fraction": 0.8, "ttl_range": null},
    "hset": {"fields_per_hash": 10, "field_selector": "index", "field_index": 3},
    "hget": {"fields_per_hash": 10, "field_selector": "index", "field_index": 3},
    "lpush": {"list_length": 10},
    "lrange": {"list_length": 10, "range_start": 0, "range_count": 10},
    "sadd": {"set_size": 10, "member_selector": "new"},
    "sismember": {"set_size": 10, "member_selector": "index", "member_index": 3},
    "zadd": {"zset_size": 10, "member_selector": "new", "score": 5},
    "zrange": {"zset_size": 10, "range_start": 0, "range_count": 5, "withscores": true},
    "xadd": {"stream_length": 10, "fields_per_entry": 1, "maxlen": 100},
    "xrange": {"stream_length": 10, "fields_per_entry": 1, "xrange_count": 10},
    "mset": {"keys_per_call": 10},
    "mget": {"keys_per_call": 10},
    "string-get-vb": {"template": "string", "generator": "valkey-benchmark", "read_fraction": 1, "ttl_range": null},
    "hget-vb": {"template": "hget", "generator": "valkey-benchmark", "fields_per_hash": 10, "field_selector": "index", "field_index": 3},
    "mget-vb": {"template": "mget", "generator": "valkey-benchmark", "keys_per_call": 10},
    "string-zipf": {"template": "string", "access_pattern": "zipfian", "zipf_alpha": 0.99, "read_fraction": 0.8, "ttl_range": null},
    "string-hotkey": {"template": "string", "access_pattern": "hotkey", "hot_fraction": 0.5, "hot_keys": 1, "read_fraction": 0.8, "ttl_range": null},
    "string-ttl": {"template": "string", "read_fraction": 0.8, "ttl_range": [1, 5]},
    "mset-cme-vb": {"template": "mset", "generator": "valkey-benchmark", "server_mode": "CME", "key_size": 24, "keys_per_call": 10},
    "string-cme": {"template": "string", "server_mode": "CME", "read_fraction": 0.8, "ttl_range": null},
    "string-evict": {"template": "string", "keys": 30000, "preload_keys": 10000, "read_fraction": 0.5, "ttl_range": null,
                     "server_config": {"maxmemory": "4mb", "maxmemory-policy": "allkeys-lru"}}
  }
}
