[
  {
    "test_name": "mixed-rw-smoke",
    "cluster_mode": false,
    "tls_mode": false,
    "io-threads": 1,
    "keyspacelen": [
      20000
    ],
    "cpu_allocation": {
      "cores_per_server": 2,
      "cores_per_client": 2
    },
    "custom-server-configs": {
      "maxmemory": "0",
      "maxmemory-policy": "noeviction",
      "activedefrag": "yes"
    },
    "per_second_sampling": true,
    "test_groups": [
      {
        "group": 1,
        "description": "mixed-rw: Zipfian and uniform 80/20 GET/SET, 4M keys of 512 B with 100 B keys, all in memory",
        "scenarios": [
          {
            "id": "zipf80",
            "type": "mixed",
            "description": "Zipfian alpha 1.0, 80/20: GET (8 clients) and SET (2) over 20000 keys of 512 B",
            "restart_before": true,
            "populate_with": "SET",
            "populate_clients": 10,
            "populate_benchmark_args": [
              "--keysize 100"
            ],
            "populate_retries": 2,
            "duration": 5,
            "pipeline": 1,
            "data_size": 512,
            "keyspacelen": 20000,
            "benchmark_args": [
              "--zipfian 1.0",
              "--keysize 100"
            ],
            "writes": [
              {
                "id": "set",
                "test": "SET",
                "clients": 2
              }
            ],
            "reads": [
              {
                "id": "get",
                "test": "GET",
                "clients": 8
              }
            ]
          },
          {
            "id": "unif80",
            "type": "mixed",
            "description": "Uniform 80/20: GET (8 clients) and SET (2) over 20000 keys of 512 B",
            "restart_before": true,
            "populate_with": "SET",
            "populate_clients": 10,
            "populate_benchmark_args": [
              "--keysize 100"
            ],
            "populate_retries": 2,
            "duration": 5,
            "pipeline": 1,
            "data_size": 512,
            "keyspacelen": 20000,
            "benchmark_args": [
              "--keysize 100"
            ],
            "writes": [
              {
                "id": "set",
                "test": "SET",
                "clients": 2
              }
            ],
            "reads": [
              {
                "id": "get",
                "test": "GET",
                "clients": 8
              }
            ]
          }
        ]
      }
    ]
  }
]
